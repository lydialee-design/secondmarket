:root {
  --color-bg-cream: #FDFBF7;      /* 米白底色 */
  --color-bg-card: #F4EFEB;       /* 淺米卡片底 */
  --color-brick-red: #A33A2B;     /* 磚紅主色 */
  --color-brick-dark: #82291C;    /* 深磚紅 */
  --color-brown-yellow: #C68B59;  /* 黃棕輔助色 */
  --color-wood-dark: #4A3525;     /* 深木褐字色 */
  --color-text-main: #332720;     /* 主內文色 */
  --color-border: #D8C8B8;        /* 邊框色 */

  --font-family-base: "Noto Serif TC", "PingFang TC", "Traditional Chinese", "Microsoft JhengHei", serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-family-base);
  background-color: var(--color-bg-cream);
  color: var(--color-text-main);
  line-height: 1.7;
}

a {
  color: var(--color-brick-red);
  text-decoration: none;
  transition: color 0.3s ease;
}

a:hover {
  color: var(--color-brick-dark);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

ul {
  list-style: none;
}

figure {
  margin: 0 0 1rem 0;
}

figcaption {
  font-size: 0.9rem;
  color: var(--color-wood-dark);
  margin-top: 0.5rem;
  font-style: italic;
}

small {
  font-size: 0.85rem;
  color: #666;
}

.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: var(--color-brick-red);
  border-bottom: 3px solid var(--color-brown-yellow);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0.8rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  color: #FFF;
  letter-spacing: 2px;
}

.main-nav ul {
  display: flex;
  gap: 1.5rem;
}

.main-nav a {
  color: #FDFBF7;
  font-size: 1.05rem;
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
}

.main-nav a:hover,
.main-nav a.active {
  background-color: var(--color-brown-yellow);
  color: #FFF;
}

.hamburger-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  flex-direction: column;
  gap: 5px;
}

.hamburger-btn span {
  width: 25px;
  height: 3px;
  background-color: #FFF;
  transition: all 0.3s ease;
}

.hero-banner {
  background: linear-gradient(rgba(74, 53, 37, 0.7), rgba(74, 53, 37, 0.7)), 
              url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
  color: #FFF;
  text-align: center;
  padding: 4.5rem 1rem;
  border-bottom: 4px solid var(--color-brick-red);
}

.hero-content h1 {
  font-size: 2.2rem;
  letter-spacing: 3px;
  margin-bottom: 0.8rem;
  color: #F4EFEB;
}

.hero-content p {
  font-size: 1.1rem;
  color: var(--color-brown-yellow);
}

.page-container {
  max-width: 1200px;
  margin: 2rem auto;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: 2rem;
}

.section-block {
  background-color: #FFF;
  padding: 1.8rem;
  border-radius: 6px;
  border: 1px solid var(--color-border);
  margin-bottom: 2rem;
  box-shadow: 2px 2px 6px rgba(0,0,0,0.03);
}

.section-title {
  font-size: 1.4rem;
  color: var(--color-brick-red);
  border-bottom: 2px dashed var(--color-brown-yellow);
  padding-bottom: 0.5rem;
  margin-bottom: 1.2rem;
}

.stall-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}

.stall-card {
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.stall-img {
  width: 100%;
  height: 160px;
  object-fit: cover;
}

.stall-info {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.stall-info h3 {
  color: var(--color-wood-dark);
  margin-bottom: 0.5rem;
}

.stall-desc {
  font-size: 0.95rem;
  margin-bottom: 1rem;
  flex-grow: 1;
}

.stall-tag {
  font-size: 0.85rem;
  color: var(--color-brick-red);
  font-weight: bold;
}

.video-wrapper {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  border-radius: 6px;
  margin: 1rem 0;
  background-color: #000;
}

.video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.transport-list {
  margin-bottom: 1.5rem;
}

.transport-list li {
  margin-bottom: 0.5rem;
  padding-left: 1.2rem;
  text-indent: -1.2rem;
}

.map-box {
  margin-top: 1rem;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  overflow: hidden;
  background-color: #f0f0f0;
  display: flex;
  justify-content: center;
}

.map-frame {
  width: 100%;
  max-width: 100%;
  border: 0;
  display: block;
}

.notice-box {
  background-color: var(--color-bg-card);
  border-left: 5px solid var(--color-brown-yellow);
}

.notice-box ul {
  padding-left: 1.2rem;
  list-style: disc;
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar-widget {
  background-color: #FFF;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 1.2rem;
}

.widget-title {
  font-size: 1.15rem;
  color: var(--color-wood-dark);
  border-bottom: 2px solid var(--color-brick-red);
  padding-bottom: 0.4rem;
  margin-bottom: 0.8rem;
}

.info-list li, .anchor-list li {
  font-size: 0.95rem;
  margin-bottom: 0.6rem;
}

.footer {
  background-color: var(--color-wood-dark);
  color: #D8C8B8;
  text-align: center;
  padding: 2rem 1rem;
  margin-top: 3rem;
  border-top: 3px solid var(--color-brown-yellow);
}

.footer p {
  margin-bottom: 0.4rem;
}

.footer a {
  color: var(--color-brown-yellow);
  text-decoration: underline;
}

.footer a:hover {
  color: #FFF;
}

@media (max-width: 991px) {
  .page-container {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .sidebar {
    order: 2;
  }

  .hero-content h1 {
    font-size: 1.8rem;
  }
}

@media (max-width: 600px) {
  .hamburger-btn {
    display: flex;
  }

  .main-nav {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--color-brick-red);
    border-bottom: 2px solid var(--color-brown-yellow);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-in-out;
  }

  .main-nav.is-active {
    max-height: 300px;
  }

  .main-nav ul {
    flex-direction: column;
    padding: 1rem 1.5rem;
    gap: 0.8rem;
  }

  .main-nav a {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.6rem 0;
  }

  .hero-banner {
    padding: 2.5rem 1rem;
  }

  .hero-content h1 {
    font-size: 1.4rem;
  }

  .hero-content p {
    font-size: 0.95rem;
  }

  .section-block {
    padding: 1.2rem;
  }
}
